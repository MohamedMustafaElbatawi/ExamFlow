# ============================================================
# ExamFlow — Server Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file to version control.
# ============================================================

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/examflow

# JWT secret — use a long, random, unique string in production
JWT_SECRET=change_this_to_a_strong_random_secret

# JWT token expiry (e.g. 7d, 24h, 60m)
JWT_EXPIRES_IN=7d

# Express server port
PORT=5000

# Node environment: development | production
NODE_ENV=development

# Allowed CORS origin (frontend URL)
CLIENT_URL=http://localhost:5173
